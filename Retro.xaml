<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource CFAFAF8}">
 <Grid.Resources>
<SolidColorBrush x:Key="C242624" Color="#242624"/>
<SolidColorBrush x:Key="C272A28" Color="#272A28"/>
<SolidColorBrush x:Key="C303630" Color="#303630"/>
<SolidColorBrush x:Key="C46564A" Color="#46564A"/>
<SolidColorBrush x:Key="C626B64" Color="#626B64"/>
<SolidColorBrush x:Key="C646D66" Color="#646D66"/>
<SolidColorBrush x:Key="C707870" Color="#707870"/>
<SolidColorBrush x:Key="C727A73" Color="#727A73"/>
<SolidColorBrush x:Key="CA1A8A1" Color="#A1A8A1"/>
<SolidColorBrush x:Key="CB4BAB4" Color="#B4BAB4"/>
<SolidColorBrush x:Key="CB7BDB8" Color="#B7BDB8"/>
<SolidColorBrush x:Key="CC4CBC3" Color="#C4CBC3"/>
<SolidColorBrush x:Key="CCCD1CB" Color="#CCD1CB"/>
<SolidColorBrush x:Key="CD9DEDA" Color="#D9DEDA"/>
<SolidColorBrush x:Key="CE2E6DF" Color="#E2E6DF"/>
<SolidColorBrush x:Key="CE3E9DF" Color="#E3E9DF"/>
<SolidColorBrush x:Key="CE6EAE6" Color="#E6EAE6"/>
<SolidColorBrush x:Key="CEDEFEA" Color="#EDEFEA"/>
<SolidColorBrush x:Key="CF0F2EE" Color="#F0F2EE"/>
<SolidColorBrush x:Key="CF0F3ED" Color="#F0F3ED"/>
<SolidColorBrush x:Key="CF4F5F2" Color="#F4F5F2"/>
<SolidColorBrush x:Key="CFAFAF8" Color="#FAFAF8"/>
<SolidColorBrush x:Key="CFFFFFF" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Ink" Color="#242624"/>
  <SolidColorBrush x:Key="Phosphor" Color="#272A28"/>
  <Style x:Key="IconButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource C242624}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Padding" Value="4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="Transparent"><ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource C242624}"/><Setter Property="Background" Value="{DynamicResource CFAFAF8}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource C242624}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,5"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource CD9DEDA}"/><Setter Property="Foreground" Value="{DynamicResource C242624}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource CE6EAE6}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="3"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource C242624}"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Frame" Background="Transparent" Padding="6,5" BorderBrush="{DynamicResource CB7BDB8}" BorderThickness="1">
     <StackPanel Orientation="Horizontal"><Border Width="10" Height="10" BorderBrush="{DynamicResource C242624}" BorderThickness="1" Margin="0,0,8,0"><Border x:Name="Light" Margin="2"/></Border><ContentPresenter/></StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Light" Property="Background" Value="{DynamicResource C242624}"/><Setter TargetName="Frame" Property="Background" Value="{DynamicResource CE6EAE6}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource CD9DEDA}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Foreground" Value="{DynamicResource C272A28}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Height="24" Background="Transparent">
     <Border Height="2" Background="{DynamicResource CB7BDB8}" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" VerticalAlignment="Center" Background="{DynamicResource C272A28}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="12" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource C46564A}" BorderBrush="{DynamicResource C46564A}" BorderThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource CD9DEDA}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="Background" Value="{DynamicResource CF0F2EE}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource CA1A8A1}" Margin="3,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Grid.Resources>
 <Border BorderBrush="{DynamicResource CB4BAB4}" BorderThickness="2" Margin="5">
  <Grid Margin="12,0,12,7">
   <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="92"/><RowDefinition Height="20"/></Grid.RowDefinitions>
   <Grid x:Name="DragBar" Background="Transparent">
    <TextBlock Text="◈ MUSIC VAULT / PERSONAL AUDIO" FontSize="11" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock Text="MV—01" FontSize="10" VerticalAlignment="Center" Margin="0,0,20,0"/>
     <Button x:Name="MinimizeButton" Content="—" Padding="8,1" Margin="0,0,4,0" ToolTip="Minimize"/>
     <Button x:Name="MaximizeButton" Content="□" Padding="8,1" Margin="0,0,4,0" ToolTip="Maximize or restore"/>
     <Button x:Name="CloseButton" Content="×" Padding="8,1" ToolTip="Close"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="VAULT" FontFamily="Consolas" FontWeight="Bold" FontSize="42" Margin="0,-7,17,0"/>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="SOUND ARCHIVE" FontWeight="Bold" FontSize="12"/><TextBlock Text="COMPACT / 01" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="NightButton" Style="{StaticResource IconButton}" Width="34" Height="34" BorderThickness="0" Background="Transparent" Padding="8" Margin="0,0,5,0" ToolTip="Switch day and night mode"/><Button x:Name="MiniButton" Style="{StaticResource IconButton}" Width="34" Height="34" BorderThickness="0" Background="Transparent" Padding="8" Margin="0,0,5,0" ToolTip="Square mini player"/><Button x:Name="AddButton" Content="＋  ADD SONGS" VerticalAlignment="Center" Background="{DynamicResource C242624}" Foreground="{DynamicResource CFFFFFF}" Padding="14,9" ToolTip="Store more songs in your collection. The player restarts after saving."/></StackPanel>
   </Grid>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="{DynamicResource C242624}" BorderThickness="2" Background="{DynamicResource CF4F5F2}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="79"/></Grid.RowDefinitions>
      <Grid Background="{DynamicResource CEDEFEA}" Margin="3,3,3,0"><TextBlock Text="01 / DECK" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="10,0"/><TextBlock x:Name="DeckState" Text="● STANDBY" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0"/></Grid>
      <Grid Grid.Row="1" ClipToBounds="True"><ContentControl x:Name="OrbitHost" IsHitTestVisible="False"/><TextBlock Text="PLAYBACK / 33⅓" Foreground="{DynamicResource C626B64}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/></Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource CCCD1CB}" BorderThickness="0,1,0,0" Margin="14,0,14,0">
       <StackPanel VerticalAlignment="Center">
        <DockPanel><TextBlock Text="NOW PLAYING" Foreground="{DynamicResource C646D66}" FontSize="10"/><TextBlock x:Name="TrackNumber" Text="— / —" HorizontalAlignment="Right" Foreground="{DynamicResource C646D66}" FontSize="10"/></DockPanel>
        <TextBlock x:Name="SongTitle" Text="Your next favorite moment." Foreground="{DynamicResource C272A28}" FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,5"/>
        <TextBlock x:Name="StatusText" Text="Select a track. Press play. Tune out." Foreground="{DynamicResource C646D66}" FontSize="10" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
    <Border Grid.Column="2" BorderBrush="{DynamicResource C242624}" BorderThickness="2" Background="{DynamicResource CFFFFFF}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="46"/><RowDefinition Height="25"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
      <Grid Background="{DynamicResource CEDEFEA}" Margin="3,3,3,0"><TextBlock Text="02 / COLLECTION" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="10,0"/><TextBlock x:Name="LibraryCount" Text="000 TRACKS" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0" FontSize="11"/></Grid>
      <Border Grid.Row="1" Margin="12,10,12,8" BorderBrush="{DynamicResource CC4CBC3}" BorderThickness="1">
       <DockPanel><TextBlock Text="⌕" Foreground="{DynamicResource C272A28}" FontSize="23" Margin="9,0" VerticalAlignment="Center"/><Grid>
        <TextBlock x:Name="SearchHint" Text="SEARCH THE ARCHIVE..." Foreground="{DynamicResource C727A73}" Margin="2,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="11"/>
        <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource C272A28}" CaretBrush="{DynamicResource C242624}" BorderThickness="0" Padding="2,0" FontSize="12" VerticalContentAlignment="Center" ToolTip="Search songs"/>
       </Grid></DockPanel>
      </Border>
      <Grid Grid.Row="2" Margin="20,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><TextBlock Text="NO." Foreground="{DynamicResource C707870}" FontSize="10"/><TextBlock Grid.Column="1" Text="TRACK / TITLE" Foreground="{DynamicResource C707870}" FontSize="10"/><TextBlock Grid.Column="2" Text="TYPE" Foreground="{DynamicResource C707870}" FontSize="10" HorizontalAlignment="Left"/></Grid>
      <Grid Grid.Row="3">
       <ListBox x:Name="SongList" Background="Transparent" Foreground="{DynamicResource C303630}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="8,0,4,0" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource CE2E6DF}" BorderThickness="0,0,0,1" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource CF0F3ED}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource CE3E9DF}"/><Setter Property="Foreground" Value="{DynamicResource C242624}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource CD9DEDA}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="34"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" FontSize="11" VerticalAlignment="Center" Opacity="0.65"/><TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontFamily="Segoe UI" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}"/><TextBlock Grid.Column="2" Text="{Binding Format}" HorizontalAlignment="Right" FontSize="10" VerticalAlignment="Center" Opacity="0.65"/><StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Tag="rename-song" Width="22" Height="24" Padding="4" BorderThickness="0" Background="Transparent" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" ToolTip="Rename song" AutomationProperties.Name="Rename song"><Path Width="12" Height="12" Stretch="Uniform" Data="M 1,9 L 1,12 L 4,11 L 12,3 L 9,0 Z M 7,2 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Button><Button Tag="delete-song" Width="22" Height="24" Padding="4" BorderThickness="0" Background="Transparent" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" ToolTip="Delete song" AutomationProperties.Name="Delete song"><Path Width="10" Height="10" Stretch="Uniform" Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Button></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="EmptyText" Text="NO SIGNAL FOUND.&#10;Try another search." Visibility="Collapsed" Foreground="{DynamicResource C646D66}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
      </Grid>
      <Border Grid.Row="4" BorderBrush="{DynamicResource CCCD1CB}" BorderThickness="0,1,0,0" Margin="12,0"><Grid><TextBlock Text="DOUBLE-CLICK TO PLAY" FontSize="10" Foreground="{DynamicResource C646D66}" VerticalAlignment="Center"/><TextBlock x:Name="ResultsText" Foreground="{DynamicResource C646D66}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="3" Margin="0,9,0,0">
    <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="{DynamicResource CEDEFEA}" Padding="10,0"><DockPanel><TextBlock x:Name="ClockText" DockPanel.Dock="Right" Text="00:00 / 00:00" Foreground="{DynamicResource C272A28}" FontSize="12" Width="110" TextAlignment="Right" VerticalAlignment="Center"/><TextBlock Text="POSITION" Foreground="{DynamicResource C646D66}" FontSize="10" Width="65" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Margin="0,0,15,0" VerticalAlignment="Center" Minimum="0" Maximum="1" IsEnabled="False" IsMoveToPointEnabled="True" ToolTip="Seek within track"/></DockPanel></Border>
    <Grid Grid.Row="1" Margin="0,10,0,8">
     <StackPanel Orientation="Horizontal"><Button x:Name="PreviousButton" Content="|◀" Width="42" ToolTip="Previous track"/><Button x:Name="PlayButton" Content="▶ PLAY" Width="88" Background="{DynamicResource CD9DEDA}" FontWeight="Bold" BorderThickness="1,1,0,1"/><Button x:Name="NextButton" Content="▶|" Width="42" ToolTip="Next track"/><CheckBox x:Name="ShuffleBox" Content="SHUFFLE" Margin="9,0,5,0"/><CheckBox x:Name="RepeatBox" Content="REPEAT"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="VOL" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.2" Width="75" ToolTip="Volume"/><TextBlock x:Name="VolumeText" Text="20" Width="32" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/></StackPanel>
    </Grid>
   </Grid>
   <Grid Grid.Row="4"><TextBlock Text="▥▥  HIGH FIDELITY" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="CollectionInfo" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/></Grid>
  </Grid>
 </Border>
</Grid>

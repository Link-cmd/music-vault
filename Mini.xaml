<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource CFAFAF8}">
 <Border BorderBrush="{DynamicResource CB4BAB4}" BorderThickness="1" Margin="5" Padding="12,6,12,9">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="48"/><RowDefinition Height="30"/><RowDefinition Height="35"/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <Grid x:Name="MiniDrag" Background="Transparent"><TextBlock Text="◈ VAULT / MP3" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ExpandMini" Content="↗" ToolTip="Return to library" Padding="9,3" Margin="0,0,5,0"/><Button x:Name="CloseMini" Content="×" Padding="9,3" ToolTip="Close player"/></StackPanel></Grid>
   <ContentControl Grid.Row="1" x:Name="MiniOrbit" IsHitTestVisible="False"/>
   <StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock x:Name="MiniTitle" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MiniStatus" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
   <DockPanel Grid.Row="3"><TextBlock x:Name="MiniClock" DockPanel.Dock="Right" FontSize="10" Width="100" TextAlignment="Right" VerticalAlignment="Center"/><Slider x:Name="MiniSeek" VerticalAlignment="Center" Margin="0,0,8,0" IsMoveToPointEnabled="True" ToolTip="Track position"/></DockPanel>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Button x:Name="MiniPrevious" Content="|◀" ToolTip="Previous"/><Button Grid.Column="1" x:Name="MiniPlay" Margin="5,0"/><Button Grid.Column="2" x:Name="MiniNext" Content="▶|" ToolTip="Next"/></Grid>
   <DockPanel Grid.Row="5" Margin="0,5,0,0"><Button x:Name="MiniNight" Style="{DynamicResource IconButton}" DockPanel.Dock="Left" Width="28" Height="24" BorderThickness="0" Background="Transparent" Padding="4"/><TextBlock Text="VOL" FontSize="10" Margin="18,0,8,0" VerticalAlignment="Center"/><Slider x:Name="MiniVolume" Minimum="0" Maximum="1" ToolTip="Volume" VerticalAlignment="Center"/></DockPanel>
  </Grid>
 </Border>
</Grid>
